# Copy to .env and fill in locally. Never commit .env.
# Every key is commented out: forge auto-loads .env, and an empty LIVE_ESCROW would
# switch the opt-in replay on. Uncomment only the keys you fill in.

# Base mainnet RPC (archive access needed for the pinned historical fork suites).
# Used by fork suites that open a second fork of a past block.
# RPC_8453=https://your-base-mainnet-rpc.example

# Set to true only against a local anvil fork where the F-01 package was rehearsed
# (test/fork/PartialReleaseUpgradeFork.t.sol).
# F01_REHEARSED=false

# Opt-in real OpenSea calldata replay (test/fork/RealCalldataReplay.t.sol).
# Fill only from a reviewed order; the replay never broadcasts.
# LIVE_ESCROW=
# LIVE_RECEIPT=
# LIVE_BUNDLE_ID=
# OPENSEA_FULFILLER=
# OPENSEA_CALL_VALUE=
# OPENSEA_CALLDATA=
# SECONDARY_FULFILLER=
# SECONDARY_CALL_VALUE=
# SECONDARY_OPENSEA_CALLDATA=
# EXPECTED_INITIAL_HOLDER=
# EXPECTED_FINAL_HOLDER=
# EXPECTED_ROYALTY_RECIPIENT=
# EXPECTED_ROYALTY_AMOUNT=

# test/legacy/DeployV2.s.sol inputs (historical V2 deploy helper; see the file for formats).
# V2_ADMIN=
# V2_TREASURY=
# V2_PROTOCOL_FEE_BPS=
# V2_PAYMENT_TOKENS=
# V2_ASSET_TOKENS=
# V2_ASSET_KINDS=
# V2_ASSET_ACCEPTANCE_MODES=
# V2_BUNDLE_OWNER=
# V2_ACCOUNT_REGISTRY=
# V2_ACCOUNT_PROXY=
# V2_ACCOUNT_IMPLEMENTATION=
# V2_TRANSFER_VALIDATOR=
# V2_SEAPORT_ZONE=


